# ─────────────────────────────────────────────────
# Operator's Booth — Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Private key for the x402 resource server (Base Sepolia testnet)
X402_PRIVATE_KEY=your_testnet_key_here

# Server port (optional, defaults to 4020)
PORT=4020
